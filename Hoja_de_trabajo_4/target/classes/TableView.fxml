<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="tableViewPane" prefHeight="520.0" prefWidth="920.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.TableViewController">

    <children>

        <!-- Logo superior -->
        <ImageView fitHeight="70.0" fitWidth="200.0" layoutX="20.0" layoutY="15.0" preserveRatio="true">
            <image>
                <Image url="/images/logoIcesi.png" />
            </image>
        </ImageView>

        <!-- Barra superior -->
        <Label layoutX="250.0" layoutY="25.0" text="Miembros del Horror Club" textFill="#f8f8f8" style="-fx-background-color: #1a1a1a; -fx-padding: 5;">
            <font>
                <Font name="System Bold" size="22.0" />
            </font>
        </Label>

        <!-- Filtros -->
        <Label layoutX="40.0" layoutY="100.0" text="Filtrar por nivel de fanatismo:" />
        <ComboBox fx:id="fanaticismFilter" layoutX="230.0" layoutY="95.0" prefWidth="120.0" promptText="Nivel (1-5)" />

        <Label layoutX="390.0" layoutY="100.0" text="Filtrar por subgénero:" />
        <ComboBox fx:id="subgenreFilter" layoutX="530.0" layoutY="95.0" prefWidth="160.0" promptText="Subgénero" />

        <Button fx:id="filterButton" layoutX="710.0" layoutY="94.0" mnemonicParsing="false"
                onAction="#applyFilters" text="Filtrar"
                style="-fx-background-color: #272727; -fx-text-fill: white;" />

        <Button fx:id="clearFilterButton" layoutX="800.0" layoutY="94.0" mnemonicParsing="false"
                onAction="#clearFilters" text="Limpiar"
                style="-fx-background-color: #5a5a5a; -fx-text-fill: white;" />

        <!-- Tabla de miembros -->
        <TableView fx:id="membersTable" layoutX="40.0" layoutY="140.0" prefHeight="340.0" prefWidth="840.0">

            <columns>
                <TableColumn fx:id="idColumn" prefWidth="130.0" text="ID" />
                <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Nombre completo" />
                <TableColumn fx:id="ageColumn" prefWidth="60.0" text="Edad" />
                <TableColumn fx:id="emailColumn" prefWidth="150.0" text="Correo" />
                <TableColumn fx:id="fanaticismColumn" prefWidth="90.0" text="Nivel Fanatismo" />
                <TableColumn fx:id="movieColumn" prefWidth="120.0" text="Película Favorita" />
                <TableColumn fx:id="subgenreColumn" prefWidth="100.0" text="Subgénero" />
                <TableColumn fx:id="posterColumn" prefWidth="80.0" text="Carátula" />
            </columns>

        </TableView>

        <!-- Botones inferiores -->
        <Button fx:id="viewDetailButton" layoutX="740.0" layoutY="490.0" mnemonicParsing="false"
                onAction="#viewMemberDetail" text="Ver Detalle"
                style="-fx-background-color: #272727; -fx-text-fill: white;" />

        <Button fx:id="backButton" layoutX="40.0" layoutY="490.0" mnemonicParsing="false"
                onAction="#returnToMainView" text="Volver"
                style="-fx-background-color: #272727; -fx-text-fill: white;" />

    </children>
</AnchorPane>
